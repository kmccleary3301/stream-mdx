{
  "name": "stream-mdx-monorepo",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "biome check --diagnostic-level=error --files-ignore-unknown=true .",
    "lint:fix": "biome check --write --unsafe --files-ignore-unknown=true .",
    "build": "npm run build:packages && npm -w streaming-markdown-starter run build",
    "build:packages": "npm -w @stream-mdx/core run build && npm -w @stream-mdx/protocol run build && npm -w @stream-mdx/plugins run build && npm -w @stream-mdx/worker run build && npm -w @stream-mdx/react run build && npm -w @stream-mdx/mermaid run build && npm -w @stream-mdx/unified run build && npm -w @stream-mdx/tui run build && npm -w @stream-mdx/theme-tailwind run build && npm -w stream-mdx run build",
    "ci:pack-smoke": "tsx scripts/ci-pack-smoke.ts",
    "test": "npm --workspaces --if-present run test",
    "mutation": "node scripts/mutation/run.mjs",
    "clean": "npm --workspaces --if-present run clean",
    "markdown-v2:build:packages": "npm run build:packages",
    "markdown-v2:test:packages": "npm --workspaces --if-present run test",
    "worker:build": "npm -w @stream-mdx/worker run build:hosted && tsx scripts/copy-hosted-worker.ts",
    "docs:prepare": "npm run build:packages",
    "docs:worker:build:raw": "npm -w @stream-mdx/worker run build:hosted && tsx scripts/copy-hosted-worker.ts --to apps/docs/public/workers/markdown-worker.js",
    "docs:worker:build": "npm run docs:prepare && npm run docs:worker:build:raw",
    "docs:snapshots:build:raw": "tsx scripts/compile-docs-snapshots.ts",
    "docs:snapshots:build": "npm run docs:worker:build && npm run docs:snapshots:build:raw",
    "docs:dev": "npm run docs:prepare && npm run docs:worker:build:raw && npm run docs:snapshots:build:raw && npm -w stream-mdx-docs run dev",
    "docs:build": "npm run docs:prepare && npm run docs:worker:build:raw && npm run docs:snapshots:build:raw && npm -w stream-mdx-docs run build",
    "docs:check-links": "tsx scripts/check-docs-links.ts",
    "docs:start": "npm -w stream-mdx-docs run start",
    "docs:sticky-scroll:check": "tsx scripts/sticky-scroll-check.ts",
    "docs:quality:audit": "tsx scripts/docs-quality-audit.ts",
    "docs:css:snapshot": "tsx scripts/css-snapshot-docs.ts",
    "docs:screenshots": "npm exec -- tsx scripts/capture-docs-screenshots.ts",
    "docs:screenshots:smoke": "CAPTURE_ONLY=\"/,/docs/getting-started,/docs/tui-json-protocol,/docs/guides/mermaid-diagrams\" CAPTURE_OUT_DIR=\"tmp/screenshots/docs-site-smoke\" CAPTURE_FAIL_ON_ERRORS=1 CAPTURE_FAIL_ON_CONSOLE=1 CAPTURE_FAIL_ON_OVERLAY=1 npm exec -- tsx scripts/capture-docs-screenshots.ts",
    "vercel:parity": "bash scripts/vercel-build-parity.sh",
    "example:tui-minimal": "node examples/tui-minimal/index.mjs",
    "perf:demo": "tsx scripts/perf/run-demo-perf.ts",
    "perf:compare": "tsx scripts/perf/compare-perf-harness.ts",
    "perf:characterize:scheduler": "tsx scripts/perf/characterize-scheduler-modes.ts",
    "perf:gate": "tsx scripts/perf/gate-perf-harness.ts",
    "perf:harness": "tsx scripts/perf/run-perf-harness.ts",
    "perf:sync-fixtures": "tsx scripts/perf/sync-perf-fixtures.ts",
    "perf:property-oracle": "tsx scripts/perf/property-oracle.ts",
    "perf:finalize-scaling": "tsx scripts/perf/finalize-scaling.ts",
    "perf:short-message": "tsx scripts/perf/short-message-latency.ts",
    "test:benchmarks:methodology": "tsx scripts/check-benchmark-methodology.ts",
    "test:conformance": "tsx scripts/conformance/run-commonmark.mts --check",
    "test:conformance:update": "tsx scripts/conformance/run-commonmark.mts --update-baseline",
    "test:conformance:base-differential": "tsx scripts/conformance/run-base-differential.mts",
    "test:conformance:render-frontiers": "tsx scripts/conformance/run-render-frontier-parity.mts",
    "test:snippets": "tsx scripts/analyze-test-snippets.ts",
    "test:regression": "npm run test:regression:html && npm run test:regression:styles",
    "test:regression:html": "tsx scripts/regression/run-html-snapshots.ts",
    "test:regression:html:update": "UPDATE_SNAPSHOTS=1 tsx scripts/regression/run-html-snapshots.ts",
    "test:regression:scheduler-parity": "tsx scripts/regression/run-scheduler-parity.ts",
    "test:regression:seeded-smoke": "tsx scripts/regression/run-seeded-smoke.ts",
    "test:regression:seeded-smoke:server": "tsx scripts/regression/run-seeded-smoke-with-server.ts",
    "test:regression:shell-accessibility": "tsx scripts/regression/run-shell-accessibility.ts",
    "test:regression:p4-viewport-browser": "tsx scripts/p4-viewport-browser-smoke.ts",
    "p7:syntax-smoke": "tsx scripts/p7-syntax-extension-browser-smoke.ts",
    "test:regression:style-invariants": "tsx scripts/regression/run-style-invariants.ts",
    "test:regression:styles": "tsx scripts/regression/run-style-snapshots.ts",
    "test:regression:styles:update": "UPDATE_SNAPSHOTS=1 tsx scripts/regression/run-style-snapshots.ts",
    "test:runtime:worker-races": "tsx scripts/test-runtime-worker-races.ts",
    "test:reliability:packages": "npm -w @stream-mdx/core run test && npm -w @stream-mdx/worker run test && npm -w @stream-mdx/react run test",
    "test:reliability:docs": "npm run test:regression:styles && npm run test:runtime:worker-races",
    "determinism:matrix": "npm run worker:build && tsx scripts/determinism/run-worker-matrix.ts",
    "determinism:html-parity": "tsx scripts/determinism/html-parity.ts",
    "release:gates": "tsx scripts/release-gates.ts",
    "release:prepare:v0.5.0": "STREAM_MDX_EXPECT_VERSION=0.5.0 bash scripts/release-v0.5.0.sh --prepare-only",
    "release:publish:v0.5.0": "bash scripts/publish-v0.5.0.sh",
    "release:v0.5.0": "bash scripts/release-v0.5.0.sh",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "docs:style-primitives:audit": "tsx scripts/audit-frontend-style-primitives.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3",
    "@changesets/cli": "^2.28.1",
    "@playwright/test": "1.58.2",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "commonmark-spec": "^0.31.2",
    "fast-check": "^4.10.2",
    "hast-util-from-html": "^2.0.3",
    "jsdom": "^24.0.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "parse5": "7.3.0",
    "playwright": "1.58.2",
    "streamdown": "2.7.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
