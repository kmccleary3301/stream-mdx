      "id": "988a3bf",
      "type": "paragraph",
      "isFinalized": true,
      "payload": {
        "raw": "You can register custom code fence renderers for arbitrary languages using `codeRenderers`. Built-in options include `MermaidBlock` and `ArtifactFrame`, which sandboxes HTML visualizations inside an isolated iframe:",
        "range": {
          "from": 1374,
          "to": 1589
        },
        "inline": [
          {
            "kind": "text",
            "text": "You can register custom code fence renderers for arbitrary languages using "
          },
          {
            "kind": "code",
            "text": "codeRenderers"
          },
          {
            "kind": "text",
            "text": ". Built-in options include "
          },
          {
            "kind": "code",
            "text": "MermaidBlock"
          },
          {
            "kind": "text",
            "text": " and "
          },
          {
            "kind": "code",
            "text": "ArtifactFrame"
          },
          {
            "kind": "text",
            "text": ", which sandboxes HTML visualizations inside an isolated iframe:"
          }
        ]
      }
    },
