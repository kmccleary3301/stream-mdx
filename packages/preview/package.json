{
  "name": "@stream-mdx/preview",
  "version": "0.1.0",
  "private": true,
  "description": "Optional local project preview runtime for StreamMDX",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node ./scripts/build-react-vendor.mjs && node ./scripts/copy-esbuild-wasm.mjs && node ./scripts/copy-tailwind-assets.mjs",
    "test": "tsx --test src/__tests__/controller.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "demo": "node ./scripts/serve-demo.mjs"
  },
  "dependencies": {
    "esbuild-wasm": "0.25.11",
    "js-tokens": "4.0.0",
    "loose-envify": "1.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "scheduler": "0.23.2",
    "tailwindcss": "4.1.18"
  }
}
