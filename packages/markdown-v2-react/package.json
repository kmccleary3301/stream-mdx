{
  "name": "@stream-mdx/react",
  "version": "1.0.0",
  "description": "React renderer, scheduler, and worker wiring for the Streaming Markdown V2 pipeline",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmccleary3301/stream-mdx.git",
    "directory": "packages/markdown-v2-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./streaming-markdown": {
      "types": "./dist/streaming-markdown.d.ts",
      "import": "./dist/streaming-markdown.mjs",
      "require": "./dist/streaming-markdown.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.cjs"
    },
    "./components/bottom-stick-scroll-area": {
      "types": "./dist/components/bottom-stick-scroll-area.d.ts",
      "import": "./dist/components/bottom-stick-scroll-area.mjs",
      "require": "./dist/components/bottom-stick-scroll-area.cjs"
    },
    "./components/diff-renderer": {
      "types": "./dist/components/diff-renderer.d.ts",
      "import": "./dist/components/diff-renderer.mjs",
      "require": "./dist/components/diff-renderer.cjs"
    },
    "./components/katex-math": {
      "types": "./dist/components/katex-math.d.ts",
      "import": "./dist/components/katex-math.mjs",
      "require": "./dist/components/katex-math.cjs"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.mjs",
      "require": "./dist/renderer.cjs"
    },
    "./renderer/patch-commit-scheduler": {
      "types": "./dist/renderer/patch-commit-scheduler.d.ts",
      "import": "./dist/renderer/patch-commit-scheduler.mjs",
      "require": "./dist/renderer/patch-commit-scheduler.cjs"
    },
    "./renderer/patch-coalescing": {
      "types": "./dist/renderer/patch-coalescing.d.ts",
      "import": "./dist/renderer/patch-coalescing.mjs",
      "require": "./dist/renderer/patch-coalescing.cjs"
    },
    "./renderer/patch-batching": {
      "types": "./dist/renderer/patch-batching.d.ts",
      "import": "./dist/renderer/patch-batching.mjs",
      "require": "./dist/renderer/patch-batching.cjs"
    },
    "./renderer/store": {
      "types": "./dist/renderer/store.d.ts",
      "import": "./dist/renderer/store.mjs",
      "require": "./dist/renderer/store.cjs"
    },
    "./math/display-wrapper": {
      "types": "./dist/math/display-wrapper.d.ts",
      "import": "./dist/math/display-wrapper.mjs",
      "require": "./dist/math/display-wrapper.cjs"
    },
    "./contexts/math-tracker": {
      "types": "./dist/contexts/math-tracker.d.ts",
      "import": "./dist/contexts/math-tracker.mjs",
      "require": "./dist/contexts/math-tracker.cjs"
    },
    "./trusted-mdx/server": {
      "types": "./dist/trusted-mdx/server.d.ts",
      "import": "./dist/trusted-mdx/server.mjs",
      "require": "./dist/trusted-mdx/server.cjs"
    },
    "./_internal/trusted-mdx-native-children": {
      "types": "./dist/trusted-mdx/native-children-slot.d.ts",
      "import": "./dist/trusted-mdx/native-children-slot.mjs",
      "require": "./dist/trusted-mdx/native-children-slot.cjs"
    },
    "./trusted-mdx": {
      "types": "./dist/trusted-mdx/index.d.ts",
      "import": "./dist/trusted-mdx/index.mjs",
      "require": "./dist/trusted-mdx/index.cjs"
    }
  },
  "files": [
    "dist",
    "shadcn",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsup",
    "test": "tsx ../../scripts/run-tests.ts __tests__",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@stream-mdx/core": "1.0.0",
    "@stream-mdx/worker": "1.0.0"
  },
  "devDependencies": {
    "jsdom": "^26.0.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "katex": "^0.16.0"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    }
  }
}
