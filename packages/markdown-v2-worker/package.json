{
  "name": "@stream-mdx/worker",
  "version": "1.0.0",
  "description": "Worker client utilities and shared worker helpers for the Streaming Markdown V2 pipeline",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmccleary3301/stream-mdx.git",
    "directory": "packages/markdown-v2-worker"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.mjs",
      "require": "./dist/engine/index.cjs"
    },
    "./worker-client": {
      "types": "./dist/worker-client.d.ts",
      "import": "./dist/worker-client.mjs",
      "require": "./dist/worker-client.cjs"
    },
    "./direct": {
      "types": "./dist/direct.d.ts",
      "import": "./dist/direct.mjs",
      "require": "./dist/direct.cjs"
    },
    "./mdx-compile": {
      "types": "./dist/mdx-compile.d.ts",
      "import": "./dist/mdx-compile.mjs",
      "require": "./dist/mdx-compile.cjs"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.cjs"
    },
    "./hosted/markdown-worker.js": "./dist/hosted/markdown-worker.js",
    "./dist/hosted/markdown-worker.js": "./dist/hosted/markdown-worker.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsup --config tsup.worker-engine.config.ts",
    "build:hosted": "tsup --config tsup.hosted-worker.config.ts",
    "test": "tsx ../../scripts/run-tests.ts __tests__",
    "clean": "rm -rf dist",
    "prepack": "npm run build && npm run build:hosted"
  },
  "dependencies": {
    "@lezer/common": "^1.2.3",
    "@lezer/lr": "^1.4.2",
    "@lezer/markdown": "^1.3.0",
    "@stream-mdx/core": "1.0.0",
    "@stream-mdx/plugins": "1.0.0",
    "@mdx-js/mdx": "^3.1.0",
    "@shikijs/engine-javascript": "^1.29.2",
    "@shikijs/engine-oniguruma": "^1.29.2",
    "character-entities": "^2.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^1.29.2"
  }
}
