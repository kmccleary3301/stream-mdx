{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "maxSize": 1048576,
    "ignore": [
      ".worktrees/**",
      ".codex-optimization/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/out/**",
      "**/coverage/**",
      "**/node_modules/**",
      "**/*.tsbuildinfo",
      "apps/docs/.generated/**",
      "apps/docs/public/workers/**",
      "examples/**/public/workers/**",
      "tests/regression/artifacts/**",
      "scripts/perf/diagnostic-dist/**",
      "tests/regression/snapshots/**",
      "tmp/**",
      "docs_tmp/**"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "organizeImports": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noConstAssign": "error",
        "noGlobalObjectCalls": "error",
        "noInvalidConstructorSuper": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noPrecisionLoss": "error",
        "noSelfAssign": "error",
        "noSetterReturn": "error",
        "noSwitchDeclarations": "error",
        "noUndeclaredVariables": "error",
        "noUnreachable": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "off",
        "useHookAtTopLevel": "off",
        "useIsNan": "error",
        "useValidForDirection": "error",
        "useYield": "error"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "suspicious": {
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noCompareNegZero": "error",
        "noDebugger": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noFallthroughSwitchClause": "error",
        "noFunctionAssign": "error",
        "noImportAssign": "error",
        "noRedeclare": "error",
        "noShadowRestrictedNames": "error"
      }
    }
  },
  "javascript": {
    "globals": ["React", "JSX"]
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  }
}
